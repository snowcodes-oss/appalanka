---
/**
 * Inline SVG icons (stroke based, 24x24). Decorative by default (aria-hidden);
 * pass `label` to expose an accessible name instead.
 */
interface Props {
  name: keyof typeof icons;
  label?: string;
  class?: string;
}

const icons = {
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="m5 12 4.5 4.5L19 7"/>',
  music: '<path d="M9 18V6l11-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"/>',
  question: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 1-1 1.7M12 17h.01"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  car: '<path d="M5 16l1.5-5.5A2 2 0 0 1 8.4 9h7.2a2 2 0 0 1 1.9 1.5L19 16M3 16h18v3H3z"/><circle cx="7.5" cy="19" r="1.5"/><circle cx="16.5" cy="19" r="1.5"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  leaf: '<path d="M4 20c0-9 5-14 16-16 0 11-5 16-14 16"/><path d="M4 20c3-5 7-8 12-11"/>',
  cocktail: '<path d="M4 4h16l-8 9-8-9zM12 13v7M8 20h8"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 13.5a6.5 6.5 0 0 1 3.5 6.5"/>',
  parking: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 17v-4m0 0V8h3.5a2.5 2.5 0 0 1 0 5H9z"/>',
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0M6 12.5a9 9 0 0 1 12 0M9.5 16a4 4 0 0 1 5 0"/><path d="M12 19.5h.01"/>',
  paw: '<circle cx="7" cy="9" r="1.8"/><circle cx="11" cy="5.5" r="1.8"/><circle cx="16" cy="6.5" r="1.8"/><circle cx="19" cy="11" r="1.8"/><path d="M8.5 19.5c-2 0-2.5-2-1.3-3.6C8.7 14 10 12 13 12s4.3 2 5.8 3.9c1.2 1.6.7 3.6-1.3 3.6-1.5 0-2.5-.8-4.5-.8s-3 .8-4.5.8z"/>',
  access: '<circle cx="12" cy="4" r="1.5"/><path d="M8 9h8l-1 5h-4M12 9v5M9.5 14a4.5 4.5 0 1 0 6 4.2"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M7 15h4"/>',
  star: '<path d="m12 3 2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z" fill="currentColor" stroke="none"/>',
  spark: '<path d="M12 3v18M3 12h18M6 6l12 12M18 6 6 18"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  gift: '<rect x="3" y="9" width="18" height="12" rx="2"/><path d="M3 13h18M12 9v12M12 9c-2.5 0-4.5-1.3-4.5-3S9 3.5 10.5 4.5 12 9 12 9zm0 0c2.5 0 4.5-1.3 4.5-3S15 3.5 13.5 4.5 12 9 12 9z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  facebook: '<path d="M14 8.5V6.8c0-.8.5-1.3 1.3-1.3H17V2h-2.6C11.6 2 10 3.7 10 6.4v2.1H7.5V12H10v10h4V12h2.7l.5-3.5z"/>',
  tiktok: '<path d="M14 3v11.2a3.3 3.3 0 1 1-3.3-3.3M14 3c.3 2.7 2 4.7 4.8 5"/>',
} as const;

const { name, label, class: className } = Astro.props;
const svg = icons[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
  set:html={(label ? `<title>${label}</title>` : '') + svg}
/>
