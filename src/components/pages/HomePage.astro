---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Hours from '../Hours.astro';
import MapCard from '../MapCard.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import Marquee from '../Marquee.astro';
import heroImg from '../../assets/images/salle-bar.jpg';
import curryImg from '../../assets/images/curry.jpg';
import curryBiryaniImg from '../../assets/images/curry-biryani.jpg';
import cocktailsImg from '../../assets/images/cocktails.jpg';
import partagerImg from '../../assets/images/partager.jpg';
import bowlImg from '../../assets/images/bowl-power-lanka.jpg';
import boeufImg from '../../assets/images/plat-boeuf-confit.jpg';
import dessertImg from '../../assets/images/moelleux-chocolat.jpg';
import { site } from '../../data/site';
import { highlights, formatPrice, type Lang } from '../../data/menu';
import { useT } from '../../i18n/ui';
import { localePath } from '../../i18n/config.js';
import { faqJsonLd } from '../../i18n/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const phone = site.phone.display;
const imgByKey: Record<string, ImageMetadata> = { 'curry-biryani': curryBiryaniImg, cocktails: cocktailsImg, partager: partagerImg };
const tileImgs = [curryImg, bowlImg, boeufImg, dessertImg];

const copy = {
  fr: {
    title: 'Appa Lanka | Restaurant à Conques-sur-Orbiel près de Carcassonne',
    description:
      'Appa Lanka, restaurant et bar à cocktails à Conques-sur-Orbiel, à 10 min de Carcassonne : cuisine traditionnelle revisitée, spécialités sri-lankaises, cocktails signatures, concerts et karaoké.',
    h1: 'Restaurant & bar à cocktails à Conques-sur-Orbiel',
    words: [
      { label: 'Manger', key: 'menu' as const, hash: '#soir' },
      { label: 'Trinquer', key: 'menu' as const, hash: '#cocktails' },
      { label: 'Partager', key: 'events' as const, hash: '' },
    ],
    heroAlt: 'La salle du restaurant Appa Lanka : tables en bois, fauteuils en velours et bar éclairé sous des plantes suspendues',
    metaHours: 'Mer.–sam. soir · Mer.–ven. midi',
    statement: ['Une cuisine maison', 'entre Occitanie', 'et Sri Lanka, à 10 minutes', 'de Carcassonne'],
    marquee: [
      { icon: 'check', label: 'Fait maison' },
      { icon: 'leaf', label: 'Épices douces' },
      { icon: 'users', label: 'Options végétariennes' },
      { icon: 'gift', label: 'Menu enfant 12 €' },
      { icon: 'access', label: 'Accès PMR' },
      { icon: 'parking', label: 'Parking gratuit' },
      { icon: 'paw', label: 'Animaux acceptés' },
      { icon: 'wifi', label: 'Wi-Fi gratuit' },
    ],
    tilesEyebrow: 'La carte',
    tilesTitle: 'Quelques incontournables',
    tilesChips: [
      { label: 'Formule du midi', hash: '#midi' },
      { label: 'Carte du soir', hash: '#soir' },
      { label: 'Cocktails', hash: '#cocktails' },
      { label: 'Boissons', hash: '#boissons' },
    ],
    tilesCta: 'Voir toute la carte',
    maroonTitle: 'Épicé ne veut pas dire piquant.',
    maroonText: 'Toutes les saveurs, sans le piquant : nos plats sont faits pour plaire à tout le monde. Et si vous aimez quand ça pique, dites-le nous.',
    maroonTiles: [
      { badge: 'Nos plats', name: 'Curry & biryani', img: 'curry-biryani' },
      { badge: 'Cocktails', name: 'Créations signatures', img: 'cocktails' },
      { badge: 'À partager', name: 'Planches & gyosas', img: 'partager' },
    ],
    quotesTitle: 'Ce que disent nos clients',
    quotesLead: 'Note moyenne de 4,9 sur 5 sur les avis en ligne.',
    quotes: [
      { text: 'Des cocktails originaux et très bons, une carte pour tous les goûts.', who: 'Avis Google' },
      { text: 'Les plats sri-lankais sont savoureux, l’accueil est chaleureux.', who: 'Avis Tripadvisor' },
      { text: 'La salle est soignée, l’ambiance conviviale. Une belle découverte.', who: 'Avis Tripadvisor' },
    ],
    pillarsTitle: 'Manger, trinquer, partager',
    pillars: [
      { title: 'Manger', text: 'Formule du midi à 18,90 €, carte du soir entre bœuf confit 30 h, curry sri-lankais et bao XL. Des plats faits maison, à déguster seul ou à partager.', alt: 'Curry sri-lankais servi dans une poêle avec brocolis et citron vert', img: curryImg, key: 'menu' as const, cta: 'Voir la carte' },
      { title: 'Trinquer', text: 'Des cocktails signatures créés pour Appa Lanka, dont plusieurs en version sans alcool, une belle sélection de gins et de rhums, et des vins de la région.', alt: 'Trois cocktails colorés que l’on trinque au bar', img: cocktailsImg, key: 'menu' as const, cta: 'Voir les cocktails', hash: '#cocktails' },
      { title: 'Partager', text: 'Entrées et plats se dégustent seuls ou à plusieurs. Concerts, karaoké, blind tests : chaque mois, un bon prétexte pour se retrouver.', alt: 'Planche de fromages et charcuteries partagée autour de verres de vin', img: partagerImg, key: 'events' as const, cta: 'Voir les événements' },
    ],
    menuEyebrow: 'La carte',
    menuTitle: 'Quelques incontournables',
    menuNote: 'Formule du midi 18,90 € (plat + dessert) · Menu kid 12 €',
    menuCta: 'Voir toute la carte',
    eventsEyebrow: 'Événements',
    eventsTitle: 'Concerts, karaoké, blind tests…',
    eventsText: 'Chaque mois, Appa Lanka fait la fête : concerts live, soirées karaoké, blind tests, soirées DJ et diffusion des grands matchs. La salle peut aussi être privatisée pour vos événements privés ou professionnels.',
    eventsCta: 'Voir les événements',
    eventsInsta: 'Suivre l’agenda sur Instagram',
    infoTitle: 'Infos pratiques',
    faqTitle: 'Questions fréquentes',
    faq: [
      { q: 'Où se trouve le restaurant Appa Lanka ?', a: 'Au 2 rue Jean Ferrat à Conques-sur-Orbiel (11600), dans l’Aude, à environ 10 km au nord-est de Carcassonne. Comptez 15 minutes en voiture depuis la Cité ou la Bastide. Parking gratuit à proximité. <a href="/restaurant-carcassonne/">Voir comment venir depuis Carcassonne</a>.' },
      { q: 'Quels sont les horaires d’ouverture ?', a: 'Le restaurant est ouvert du mercredi au samedi soir et du mercredi au vendredi midi. Le mardi soir et le samedi midi, nous ouvrons sur réservation. Fermé le dimanche et le lundi.' },
      { q: 'Faut-il réserver ?', a: `La réservation est conseillée, surtout le week-end et les soirs d’événement. Appelez le ${phone}. Le mardi soir et le samedi midi, nous ouvrons uniquement sur réservation.` },
      { q: 'La cuisine sri-lankaise est-elle très épicée ?', a: 'Non : nos currys sont préparés avec des épices parfumées mais douces, pour plaire à tous. Si vous aimez quand ça pique, dites-le nous !' },
      { q: 'Proposez-vous des plats végétariens ou un menu enfant ?', a: 'Oui : gyozas végétariens, frites de patate douce, desserts… et un menu kid à 12 € le midi comme le soir. Signalez-nous vos allergies, l’équipe vous conseillera.' },
      { q: 'Peut-on privatiser le restaurant ?', a: 'Oui, pour un anniversaire, un repas d’entreprise, un séminaire ou une soirée entre amis. Contactez-nous par téléphone ou e-mail pour organiser votre événement.' },
      { q: 'Y a-t-il des cocktails sans alcool ?', a: 'Oui, plusieurs cocktails signatures existent en version sans alcool à 8 €, ainsi que des softs, des jus de fruits et des thés, dont un thé noir de Ceylan.' },
    ],
  },
  en: {
    title: 'Appa Lanka | Restaurant in Conques-sur-Orbiel near Carcassonne',
    description:
      'Appa Lanka, restaurant and cocktail bar in Conques-sur-Orbiel, 10 minutes from Carcassonne: revisited traditional cooking, Sri Lankan specialities, signature cocktails, live music and karaoke.',
    h1: 'Restaurant & cocktail bar in Conques-sur-Orbiel',
    words: [
      { label: 'Eat', key: 'menu' as const, hash: '#soir' },
      { label: 'Drink', key: 'menu' as const, hash: '#cocktails' },
      { label: 'Share', key: 'events' as const, hash: '' },
    ],
    heroAlt: 'The Appa Lanka dining room: wooden tables, velvet armchairs and a lit bar beneath hanging plants',
    metaHours: 'Wed–Sat evenings · Wed–Fri lunch',
    statement: ['Homemade cooking', 'between Occitania', 'and Sri Lanka, 10 minutes', 'from Carcassonne'],
    marquee: [
      { icon: 'check', label: 'Homemade' },
      { icon: 'leaf', label: 'Mild spices' },
      { icon: 'users', label: 'Vegetarian options' },
      { icon: 'gift', label: 'Kids menu €12' },
      { icon: 'access', label: 'Wheelchair access' },
      { icon: 'parking', label: 'Free parking' },
      { icon: 'paw', label: 'Pets welcome' },
      { icon: 'wifi', label: 'Free Wi-Fi' },
    ],
    tilesEyebrow: 'The menu',
    tilesTitle: 'A few must-tries',
    tilesChips: [
      { label: 'Lunch menu', hash: '#midi' },
      { label: 'Evening menu', hash: '#soir' },
      { label: 'Cocktails', hash: '#cocktails' },
      { label: 'Drinks', hash: '#boissons' },
    ],
    tilesCta: 'See the full menu',
    maroonTitle: 'Spiced, not hot.',
    maroonText: 'All the flavour, none of the heat: our dishes are made to please everyone. And if you like it spicy, just tell us.',
    maroonTiles: [
      { badge: 'Mains', name: 'Curry & biryani', img: 'curry-biryani' },
      { badge: 'Cocktails', name: 'Signature creations', img: 'cocktails' },
      { badge: 'To share', name: 'Boards & gyosas', img: 'partager' },
    ],
    quotesTitle: 'What our guests say',
    quotesLead: 'Rated 4.9 out of 5 across online reviews.',
    quotes: [
      { text: 'Original, very good cocktails and a menu for every taste.', who: 'Google review' },
      { text: 'The Sri Lankan dishes are full of flavour and the welcome is warm.', who: 'Tripadvisor review' },
      { text: 'A well-kept room and a friendly atmosphere. A lovely find.', who: 'Tripadvisor review' },
    ],
    pillarsTitle: 'Eat, drink, share',
    pillars: [
      { title: 'Eat', text: 'Lunch menu at €18.90, evening à la carte from 30-hour slow-cooked beef to Sri Lankan curry and XL bao. Homemade dishes to enjoy alone or to share.', alt: 'Sri Lankan curry served in a pan with broccoli and lime', img: curryImg, key: 'menu' as const, cta: 'See the menu' },
      { title: 'Drink', text: 'Signature cocktails created for Appa Lanka, several of them alcohol-free, a fine selection of gins and rums, and wines from the region.', alt: 'Three colourful cocktails clinked together at the bar', img: cocktailsImg, key: 'menu' as const, cta: 'See the cocktails', hash: '#cocktails' },
      { title: 'Share', text: 'Starters and mains can be enjoyed alone or together. Concerts, karaoke, blind tests: every month, a good excuse to get together.', alt: 'A cheese and charcuterie board shared over glasses of wine', img: partagerImg, key: 'events' as const, cta: 'See the events' },
    ],
    menuEyebrow: 'The menu',
    menuTitle: 'A few must-tries',
    menuNote: 'Lunch menu €18.90 (main + dessert) · Kids menu €12',
    menuCta: 'See the full menu',
    eventsEyebrow: 'Events',
    eventsTitle: 'Concerts, karaoke, blind tests…',
    eventsText: 'Every month Appa Lanka throws a party: live concerts, karaoke nights, blind tests, DJ nights and the big games on screen. The room can also be hired for private or corporate events.',
    eventsCta: 'See the events',
    eventsInsta: 'Follow the programme on Instagram',
    infoTitle: 'Practical information',
    faqTitle: 'Frequently asked questions',
    faq: [
      { q: 'Where is the Appa Lanka restaurant?', a: 'At 2 rue Jean Ferrat in Conques-sur-Orbiel (11600), in the Aude, about 10 km north-east of Carcassonne. Allow 15 minutes by car from La Cité or the Bastide. Free parking nearby. <a href="/en/restaurant-carcassonne/">See how to get here from Carcassonne</a>.' },
      { q: 'What are the opening hours?', a: 'The restaurant is open Wednesday to Saturday evenings and Wednesday to Friday lunchtimes. Tuesday evening and Saturday lunch are by reservation. Closed on Sunday and Monday.' },
      { q: 'Do I need to book?', a: `Booking is recommended, especially at weekends and on event nights. Call ${site.phone.intl}. On Tuesday evenings and Saturday lunchtimes we open by reservation only.` },
      { q: 'Is Sri Lankan food very spicy?', a: 'No: our curries are made with fragrant but mild spices to suit everyone. If you like it hot, just let us know!' },
      { q: 'Do you offer vegetarian dishes or a kids menu?', a: 'Yes: vegetarian gyozas, sweet potato fries, desserts… and a €12 kids menu at lunch and dinner. Tell us about any allergies and the team will advise you.' },
      { q: 'Can the restaurant be hired privately?', a: 'Yes, for a birthday, a company meal, a seminar or a night out with friends. Contact us by phone or e-mail to organise your event.' },
      { q: 'Are there alcohol-free cocktails?', a: 'Yes, several signature cocktails come in an alcohol-free version at €8, along with soft drinks, fruit juices and teas, including a Ceylon black tea.' },
    ],
  },
}[lang];
---

<Base lang={lang} routeKey="home" title={copy.title} description={copy.description} jsonLd={[faqJsonLd(copy.faq)]}>
  <section class="hero hero--full" aria-labelledby="hero-title">
    <div class="hero__bg">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        widths={[420, 640, 828, 1024, 1200, 1440, 1800]}
        width={1800}
        height={1013}
        sizes="100vw"
        quality={34}
        alt={copy.heroAlt}
        priority
      />
    </div>
    <div class="container center">
      <h1 id="hero-title">{copy.h1}</h1>
      <p class="hero__rule" aria-hidden="true"></p>
      <ul class="hero__words">
        {copy.words.map((w) => <li><a href={localePath(lang, w.key) + w.hash}>{w.label}</a></li>)}
      </ul>
      <ul class="hero__meta">
        <li><Icon name="pin" />{site.address.street}, {site.address.city}</li>
        <li><Icon name="clock" />{copy.metaHours}</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="statement-title">
    <div class="container center">
      <h2 class="visually-hidden" id="statement-title">{copy.pillarsTitle}</h2>
      <p class="statement">
        {copy.statement[0]}
        <img src={curryImg.src} alt="" width="64" height="64" loading="lazy" />
        {copy.statement[1]}
        <img src={cocktailsImg.src} alt="" width="64" height="64" loading="lazy" />
        {copy.statement[2]}
        <img src={bowlImg.src} alt="" width="64" height="64" loading="lazy" />
        {copy.statement[3]}
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={localePath(lang, 'menu')}>{copy.menuCta}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <Marquee items={copy.marquee} label={t('marquee.label')} />

  <section class="section section--maroon" aria-labelledby="maroon-title">
    <div class="container">
      <h2 id="maroon-title">{copy.maroonTitle}</h2>
      <p class="lead">{copy.maroonText}</p>
      <ul class="tiles" style="margin-top:2rem">
        {
          copy.maroonTiles.map((tile) => (
            <li class="tile">
              <div class="tile__media">
                <Picture
                  src={imgByKey[tile.img]}
                  formats={['avif', 'webp']}
                  width={560}
                  height={560}
                  sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2rem)"
                  alt=""
                  loading="lazy"
                />
                <span class="tile__badge">{tile.badge}</span>
              </div>
              <div class="tile__row"><span class="tile__name">{tile.name}</span></div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="menu-title">
    <div class="container">
      <p class="eyebrow">{copy.tilesEyebrow}</p>
      <h2 id="menu-title">{copy.tilesTitle}</h2>
      <ul class="chips">
        {copy.tilesChips.map((c) => <li><a href={localePath(lang, 'menu') + c.hash}>{c.label}</a></li>)}
      </ul>
      <ul class="tiles">
        {
          highlights.map((item, i) => (
            <li class="tile">
              <a class="tile__media" href={localePath(lang, 'menu') + '#soir'} aria-label={item.name[lang]}>
                <Picture
                  src={tileImgs[i]}
                  formats={['avif', 'webp']}
                  width={560}
                  height={560}
                  sizes="(min-width: 60rem) 17rem, (min-width: 40rem) 45vw, calc(100vw - 2rem)"
                  alt=""
                  loading="lazy"
                />
                {item.tags?.includes('sl') && <span class="tile__badge">{t('tags.sl')}</span>}
              </a>
              <div class="tile__row">
                <span class="tile__name">{item.name[lang]}</span>
                {item.price !== undefined && <span class="tile__price">{formatPrice(item.price, lang)}</span>}
              </div>
              {item.desc && <p class="tile__desc">{item.desc[lang]}</p>}
            </li>
          ))
        }
      </ul>
      <div class="btn-row">
        <a class="btn btn--primary" href={localePath(lang, 'menu')}>{copy.tilesCta}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--cream2" aria-labelledby="quotes-title">
    <div class="container">
      <p class="eyebrow">{copy.quotesLead}</p>
      <h2 id="quotes-title">{copy.quotesTitle}</h2>
      <ul class="quotes" style="margin-top:2rem">
        {
          copy.quotes.map((q) => (
            <li>
              <figure class="quote">
                <span class="quote__stars" role="img" aria-label="5/5">
                  <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
                </span>
                <blockquote>{q.text}</blockquote>
                <figcaption>{q.who}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--green" aria-labelledby="events-title">
    <div class="container center">
      <p class="eyebrow">{copy.eventsEyebrow}</p>
      <h2 id="events-title">{copy.eventsTitle}</h2>
      <p class="lead">{copy.eventsText}</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href={localePath(lang, 'events')}>{copy.eventsCta}</a>
        <a class="btn btn--outline" href={site.social.instagram} rel="noopener" target="_blank"><Icon name="instagram" />{copy.eventsInsta}</a>
      </div>
    </div>
  </section>

  <section class="section section--cream2" aria-labelledby="info-title">
    <div class="container">
      <h2 id="info-title">{copy.infoTitle}</h2>
      <div class="grid grid--2">
        <div class="notice">
          <Hours lang={lang} />
          <p class="menu-footnote" style="margin-bottom:0">{t('hours.summary')}</p>
        </div>
        <div>
          <ul class="info-list" style="margin-bottom:1.25rem">
            <li>
              <Icon name="pin" />
              <address>
                <span class="label">{t('address.title')}</span>
                {site.address.street}, {site.address.postalCode} {site.address.city}
              </address>
            </li>
            <li>
              <Icon name="phone" />
              <span><span class="label">{t('phone.title')}</span><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a> · <a href={`tel:${site.mobile.tel}`}>{site.mobile.display}</a></span>
            </li>
            <li>
              <Icon name="mail" />
              <span><span class="label">{t('email.title')}</span><a href={`mailto:${site.email}`}>{site.email}</a></span>
            </li>
          </ul>
          <MapCard lang={lang} />
          <p style="margin-top:1rem">
            <a href={localePath(lang, 'carcassonne')}>{t('map.fromCarcassonne')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="center">{copy.faqTitle}</h2>
      <Faq items={copy.faq} />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
