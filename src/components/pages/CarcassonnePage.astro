---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';
import Icon from '../Icon.astro';
import Hours from '../Hours.astro';
import MapCard from '../MapCard.astro';
import Faq from '../Faq.astro';
import roomImg from '../../assets/images/salle-bar-portrait.jpg';
import heroImg from '../../assets/images/salle-bar.jpg';
import { site } from '../../data/site';
import type { Lang } from '../../data/menu';
import { useT } from '../../i18n/ui';
import { localePath } from '../../i18n/config.js';
import { breadcrumbJsonLd, faqJsonLd } from '../../i18n/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const copy = {
  fr: {
    title: 'Restaurant près de Carcassonne, à 10 min de la Cité | Appa Lanka',
    description:
      'Vous cherchez un restaurant près de Carcassonne ? Appa Lanka vous attend à Conques-sur-Orbiel, à 10 km de la Cité : cuisine sri-lankaise et traditionnelle, cocktails signatures, parking gratuit.',
    h1: 'Un restaurant à 10 minutes de Carcassonne',
    lead: 'Envie de sortir de la Cité et de la Bastide pour dîner ? Appa Lanka se trouve à Conques-sur-Orbiel, à un quart d’heure de route au nord-est de Carcassonne, dans un village calme du Cabardès.',
    whyTitle: 'Pourquoi venir jusqu’à Conques-sur-Orbiel ?',
    why: [
      { icon: 'leaf', title: 'Une cuisine que l’on ne trouve nulle part ailleurs', text: 'Des spécialités sri-lankaises cuisinées par un chef originaire de l’île, et des plats traditionnels revisités : bœuf confit 30 h, bao XL, gyozas maison.' },
      { icon: 'cocktail', title: 'Un vrai bar à cocktails', text: 'Des créations signatures, clarifiées ou sans alcool, une carte de gins et de rhums, des vins de l’Aude et du Languedoc.' },
      { icon: 'music', title: 'Des soirées animées', text: 'Concerts live, karaoké, blind tests, DJ, retransmission des matchs : consultez le programme avant de venir.' },
      { icon: 'parking', title: 'Facile d’accès, stationnement gratuit', text: 'Pas de zone piétonne ni de parking payant : on se gare gratuitement à deux pas du restaurant, terrasse aux beaux jours.' },
    ],
    routeTitle: 'Comment venir depuis Carcassonne',
    route: [
      { icon: 'car', text: 'En voiture : depuis Carcassonne, prenez la direction Mazamet / Montagne Noire (D118) puis suivez Conques-sur-Orbiel. Comptez environ 15 minutes depuis la Bastide et 20 minutes depuis la Cité médiévale.' },
      { icon: 'pin', text: `Le restaurant est au ${site.address.street}, ${site.address.postalCode} ${site.address.city}. Entrez « Appa Lanka » dans votre GPS ou utilisez les boutons d’itinéraire ci-dessous.` },
      { icon: 'clock', text: 'Le soir, il n’y a pas de transport en commun entre Carcassonne et Conques-sur-Orbiel : prévoyez une voiture, un taxi ou un VTC. Pensez à réserver, surtout le week-end.' },
    ],
    aroundTitle: 'Sur la route des grottes et de la Montagne Noire',
    aroundText: 'Conques-sur-Orbiel est l’étape idéale sur la route du gouffre géant de Cabrespine et de la grotte de Limousis, à une quinzaine de minutes au nord. Le Canal du Midi (à Trèbes) et la Cité de Carcassonne sont à 10 km. Une journée de visites, une soirée chez Appa Lanka.',
    aroundAlt: 'La salle d’Appa Lanka avec son bar en briques, ses lampes en rotin et ses plantes suspendues',
    hoursTitle: 'Horaires',
    mapTitle: 'Itinéraire',
    faqTitle: 'Questions fréquentes sur l’accès depuis Carcassonne',
    faq: [
      {
        q: 'Appa Lanka se trouve-t-il dans Carcassonne ?',
        a: 'Non. Le restaurant est à Conques-sur-Orbiel, un village de l’Aude situé à environ 10 km au nord-est de Carcassonne. Comptez 15 minutes de route depuis la Bastide Saint-Louis et 20 minutes depuis la Cité médiévale.',
      },
      {
        q: 'Combien de temps faut-il pour venir depuis la Cité de Carcassonne ?',
        a: 'Environ 20 minutes en voiture. Prenez la direction Mazamet / Montagne Noire par la D118, puis suivez Conques-sur-Orbiel. Le trajet se fait entièrement en dehors des zones piétonnes et des parkings payants de la Cité.',
      },
      {
        q: 'Où se garer ?',
        a: 'Le stationnement est gratuit, dans la rue et sur le parking à deux pas du restaurant. Contrairement au centre de Carcassonne, il n’y a ni horodateur ni zone bleue.',
      },
      {
        q: 'Peut-on venir en bus ou en train depuis Carcassonne ?',
        a: 'Le soir, il n’y a pas de transport en commun entre Carcassonne et Conques-sur-Orbiel. Pour un dîner, prévoyez une voiture, un taxi ou un VTC ; le stationnement est gratuit devant le restaurant.',
      },
      {
        q: 'Existe-t-il un restaurant sri-lankais à Carcassonne ?',
        a: 'La cuisine sri-lankaise reste rare dans le Carcassonnais. Chez Appa Lanka, le chef, né au Sri Lanka, prépare currys, biryanis, kottu et hoppers à 15 minutes de Carcassonne, à côté d’une carte traditionnelle revisitée.',
      },
      {
        q: 'Jusqu’à quelle heure sert-on le soir ?',
        a: 'Le service du soir commence à 18 h. Le bar reste ouvert jusqu’à minuit du mercredi au samedi, et jusqu’à 2 h le vendredi. Une bonne option quand les cuisines ferment tôt à Carcassonne.',
      },
      {
        q: 'Que visiter dans le secteur avant de dîner ?',
        a: 'Conques-sur-Orbiel est sur la route du gouffre géant de Cabrespine et de la grotte de Limousis, à un quart d’heure au nord. La Cité de Carcassonne et le Canal du Midi à Trèbes sont à une dizaine de kilomètres.',
      },
    ],
    heroAlt: 'La salle d’Appa Lanka et son bar en briques éclairé, à Conques-sur-Orbiel',
  },
  en: {
    title: 'Restaurant near Carcassonne, 10 min from La Cité | Appa Lanka',
    description:
      'Looking for a restaurant near Carcassonne? Appa Lanka awaits you in Conques-sur-Orbiel, 10 km from La Cité: Sri Lankan and traditional cooking, signature cocktails, free parking.',
    h1: 'A restaurant 10 minutes from Carcassonne',
    lead: 'Fancy leaving La Cité and the Bastide for dinner? Appa Lanka is in Conques-sur-Orbiel, a quarter of an hour’s drive north-east of Carcassonne, in a quiet village of the Cabardès.',
    whyTitle: 'Why come all the way to Conques-sur-Orbiel?',
    why: [
      { icon: 'leaf', title: 'Food you won’t find anywhere else', text: 'Sri Lankan specialities cooked by a chef born on the island, and revisited traditional dishes: 30-hour slow-cooked beef, XL bao, homemade gyozas.' },
      { icon: 'cocktail', title: 'A real cocktail bar', text: 'Signature creations, clarified or alcohol-free, a list of gins and rums, wines from the Aude and Languedoc.' },
      { icon: 'music', title: 'Lively nights', text: 'Live concerts, karaoke, blind tests, DJ sets, live sports: check the programme before you come.' },
      { icon: 'parking', title: 'Easy access, free parking', text: 'No pedestrian zone and no paid car park: park for free a few steps from the restaurant, terrace in fine weather.' },
    ],
    routeTitle: 'How to get here from Carcassonne',
    route: [
      { icon: 'car', text: 'By car: from Carcassonne, head for Mazamet / Montagne Noire (D118) then follow signs to Conques-sur-Orbiel. Allow about 15 minutes from the Bastide and 20 minutes from the medieval Cité.' },
      { icon: 'pin', text: `The restaurant is at ${site.address.street}, ${site.address.postalCode} ${site.address.city}. Type “Appa Lanka” into your sat-nav or use the directions buttons below.` },
      { icon: 'clock', text: 'In the evening there is no public transport between Carcassonne and Conques-sur-Orbiel: plan on a car, a taxi or a ride-hailing service. Remember to book, especially at weekends.' },
    ],
    aroundTitle: 'On the road to the caves and the Montagne Noire',
    aroundText: 'Conques-sur-Orbiel is the ideal stop on the way to the giant Cabrespine chasm and the Limousis cave, about fifteen minutes to the north. The Canal du Midi (at Trèbes) and the Cité de Carcassonne are 10 km away. A day of sightseeing, an evening at Appa Lanka.',
    aroundAlt: 'The Appa Lanka dining room with its brick bar, rattan lamps and hanging plants',
    hoursTitle: 'Opening hours',
    mapTitle: 'Directions',
    faqTitle: 'Frequently asked questions about getting here from Carcassonne',
    faq: [
      {
        q: 'Is Appa Lanka in Carcassonne itself?',
        a: 'No. The restaurant is in Conques-sur-Orbiel, a village in the Aude about 10 km north-east of Carcassonne. Allow 15 minutes by car from the Bastide Saint-Louis and 20 minutes from the medieval Cité.',
      },
      {
        q: 'How long does it take from the Cité de Carcassonne?',
        a: 'About 20 minutes by car. Head for Mazamet / Montagne Noire on the D118, then follow signs to Conques-sur-Orbiel. The whole drive avoids the pedestrian zones and paid car parks around the Cité.',
      },
      {
        q: 'Where can I park?',
        a: 'Parking is free, both on the street and in the car park a few steps from the restaurant. Unlike central Carcassonne, there are no meters and no restricted zones.',
      },
      {
        q: 'Can I get here by bus or train from Carcassonne?',
        a: 'In the evening there is no public transport between Carcassonne and Conques-sur-Orbiel. For dinner, plan on a car, a taxi or a ride-hailing service; parking is free right outside the restaurant.',
      },
      {
        q: 'Is there a Sri Lankan restaurant in Carcassonne?',
        a: 'Sri Lankan cooking is still rare around Carcassonne. At Appa Lanka the chef, born in Sri Lanka, cooks curries, biryanis, kottu and hoppers 15 minutes from the city, alongside a revisited traditional menu.',
      },
      {
        q: 'How late is food served in the evening?',
        a: 'Dinner service starts at 6 pm. The bar stays open until midnight from Wednesday to Saturday, and until 2 am on Friday — useful when kitchens close early in Carcassonne.',
      },
      {
        q: 'What is there to visit nearby before dinner?',
        a: 'Conques-sur-Orbiel sits on the road to the giant Cabrespine chasm and the Limousis cave, a quarter of an hour to the north. The Cité de Carcassonne and the Canal du Midi at Trèbes are about ten kilometres away.',
      },
    ],
    heroAlt: 'The Appa Lanka dining room and its lit brick bar in Conques-sur-Orbiel',
  },
}[lang];

const crumbs = [
  { label: t('nav.home'), href: localePath(lang, 'home') },
  { label: t('nav.carcassonne') },
];
---

<Base lang={lang} routeKey="carcassonne" title={copy.title} description={copy.description} jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(copy.faq)]}>
  <PageHeader lang={lang} title={copy.h1} lead={copy.lead} crumbs={crumbs} image={heroImg} imageAlt={copy.heroAlt} />

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title">{copy.whyTitle}</h2>
      <div class="grid grid--2">
        {
          copy.why.map((w) => (
            <article class="event-card">
              <Icon name={w.icon as any} />
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--cream2" aria-labelledby="route-title">
    <div class="container grid grid--2">
      <div>
        <h2 id="route-title">{copy.routeTitle}</h2>
        <ul class="info-list">
          {copy.route.map((r) => <li><Icon name={r.icon as any} /><span>{r.text}</span></li>)}
        </ul>
      </div>
      <div>
        <h2 class="visually-hidden">{copy.mapTitle}</h2>
        <MapCard lang={lang} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="around-title">
    <div class="container media-split media-split--reverse">
      <div class="prose">
        <h2 id="around-title">{copy.aroundTitle}</h2>
        <p>{copy.aroundText}</p>
        <h3>{copy.hoursTitle}</h3>
        <Hours lang={lang} hideCaption />
        <div class="btn-row">
          <a class="btn btn--primary" href={`tel:${site.phone.tel}`}><Icon name="phone" />{t('cta.book')}</a>
          <a class="btn btn--outline" href={localePath(lang, 'menu')}>{t('cta.menu')}</a>
        </div>
      </div>
      <Picture src={roomImg} formats={['avif', 'webp']} width={720} height={900} sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)" alt={copy.aroundAlt} loading="lazy" style="aspect-ratio:4/5" />
    </div>
  </section>

  <section class="section section--cream2" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="center">{copy.faqTitle}</h2>
      <Faq items={copy.faq} />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
