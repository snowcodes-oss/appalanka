---
import { weekSchedule, type Slot } from '../data/site';
import { useT, dayNames } from '../i18n/ui';
import type { Lang } from '../data/menu';

interface Props {
  lang: Lang;
  /** Visually hide the caption (when a heading already introduces the table). */
  hideCaption?: boolean;
}
const { lang, hideCaption = false } = Astro.props;
const t = useT(lang);

function cell(slot: Slot) {
  if (!slot) return { text: t('hours.closed'), closed: true, resa: false };
  return { text: slot.hours, closed: false, resa: 'onReservation' in slot };
}
---

<table class="hours">
  <caption class:list={{ 'visually-hidden': hideCaption }}>{t('hours.title')}</caption>
  <thead>
    <tr>
      <th scope="col"><span class="visually-hidden">{lang === 'fr' ? 'Jour' : 'Day'}</span></th>
      <th scope="col">{t('hours.lunch')}</th>
      <th scope="col">{t('hours.dinner')}</th>
    </tr>
  </thead>
  <tbody>
    {
      weekSchedule.map((d) => {
        const lunch = cell(d.lunch);
        const dinner = cell(d.dinner);
        return (
          <tr>
            <th scope="row">{dayNames[lang][d.day]}</th>
            <td class:list={{ closed: lunch.closed }}>
              {lunch.text}
              {lunch.resa && <span class="resa">{t('hours.onReservation')}</span>}
            </td>
            <td class:list={{ closed: dinner.closed }}>
              {dinner.text}
              {dinner.resa && <span class="resa">{t('hours.onReservation')}</span>}
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>
