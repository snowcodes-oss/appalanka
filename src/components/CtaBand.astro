---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { useT } from '../i18n/ui';
import { localePath } from '../i18n/config.js';
import type { Lang } from '../data/menu';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
}
const { lang, title, text } = Astro.props;
const t = useT(lang);
---

<section class="section cta-band" aria-labelledby="cta-title">
  <div class="container center">
    <h2 id="cta-title">{title ?? t('cta.bandTitle')}</h2>
    <p class="lead">{text ?? t('cta.bandText')}</p>
    <p><a class="big-phone" href={`tel:${site.phone.tel}`}>{site.phone.display}</a></p>
    <div class="btn-row">
      <a class="btn btn--primary" href={`tel:${site.phone.tel}`}><Icon name="phone" />{t('cta.book')}</a>
      <a class="btn btn--outline" href={localePath(lang, 'contact')}>{t('nav.contact')}</a>
    </div>
  </div>
</section>
